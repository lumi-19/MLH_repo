# ShortLink API — Environment Configuration
# Copy this file to .env and adjust values as needed.

# Database connection string (SQLite default — swap to Postgres for production)
DATABASE_URL=sqlite:///./shortlink.db

# Public base URL of the service (used to build shortened URLs in responses)
BASE_URL=http://localhost:8000

# Length of generated short codes (default: 6 → ~56 billion combinations)
SHORT_CODE_LENGTH=6

# CORS origins — comma-separated list or "*" to allow all
CORS_ORIGINS=*